# Copy to .env and fill in, then load it into your shell: `set -a; . ./.env; set +a`
# (Why reads environment variables; it does not load .env files itself.)
# Every key is optional. Without them Why runs offline with its rule-based miner and guard templates.

# Nemotron on Nebius Token Factory
NEBIUS_API_KEY=your-nebius-token-factory-key
# WHY_MODEL_NANO=nvidia/NVIDIA-Nemotron-Nano-9B-v2
# WHY_MODEL_SUPER=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
# WHY_MODEL_ULTRA=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# Tavily (why assume)
TAVILY_API_KEY=your-tavily-key

# GitHub: PR mining (falls back to `gh auth token`)
GITHUB_TOKEN=your-github-token

# GitHub App (why serve)
WHY_GITHUB_APP_ID=123456
WHY_GITHUB_PRIVATE_KEY=/path/to/why-app.private-key.pem   # a path, or the PEM contents
WHY_GITHUB_WEBHOOK_SECRET=change-me

# Nebius object storage for sandboxes over 64 KiB (sandbox: nebius)
NEBIUS_S3_ACCESS_KEY_ID=your-access-key-id
NEBIUS_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Server
WHY_DASHBOARD_WRITE=1
# WHY_DASHBOARD_TOKENS=maya:change-me,theo:change-me
# WHY_MCP_TOKEN=change-me
# WHY_REGISTRY_TOKEN=change-me
# WHY_REGISTRY_URL=https://your-why-server.example
# WHY_OFFLINE=1
